class TreeNode:
    def __init__(self, val):
        self.val = val
        self.left = None
        self.right = None

root = TreeNode(1)
root.left = TreeNode(2)
root.right = TreeNode(3)
root.left.left = TreeNode(4)
root.left.right = TreeNode(5)
root.right.right = TreeNode(6)

def preorder_traversal(node):
    if node is None:
        return
    print(node.val, end=' ')
    next=node.left
    preorder_traversal(next)
    nextr=node.right
    preorder_traversal(nextr)
