def preorder_traversal(node):
    if node is None:
        return
    print(node.val, end=' ')
    next=node.left
    preorder_traversal(next)
    nextr=node.right
    preorder_traversal(nextr)

def inorder(node):
    if node is None:
        return
    inorder(node.left)   # this also first try :)
    print(node.val, end=' ')
    inorder(node.right)



def postorder(node):
    if node is None:
        return
    postorder(node.left)   # so easy:)
    postorder(node.right)
    print(node.val, end=' ')


def BFS(node):
    if node is None:
        return
    queue=[node]
    while queue:
        current=queue.pop(0)
        print(current.val, end=' ')
        if current.left:
            queue.append(current.left)
        if current.right:
            queue.append(current.right)


def preorder_stack(node):
    if node is None:
        return
    stack=[node]
    while stack:
        current=stack.pop()
        print(current.val, end=' ')
        if current.right:
            stack.append(current.right)
        if current.left:
            stack.append(current.left)

def inorder_stack(node):
    stack = []
    current = node
    while stack or current:          
        if current:
            stack.append(current)
            current = current.left
            continue
        current = stack.pop()
        print(current.val, end=' ')
        current = current.right
